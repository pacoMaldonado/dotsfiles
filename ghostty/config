# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                     DOTFILES - GHOSTTY CONFIGURATION                         ║
# ║            Basado en Gentleman.Dots — Adaptado para Linux (Wayland)          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
# Guía completa de uso y personalización en: ./GUIA_GHOSTTY.md
# TIP: Después de hacer cualquier cambio aquí, presiona [Alt + r] en Ghostty
#      para recargar la configuración al instante sin cerrar la terminal.


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 1. TIPOGRAFÍA (FONT)                                                         │
# └──────────────────────────────────────────────────────────────────────────────┘
# Descomenta la fuente que prefieras usar y presiona [Alt + r]:

# font-family = JetBrainsMono Nerd Font
font-family = FiraCode Nerd Font

font-size = 14


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 2. VENTANA Y APARIENCIA (WINDOW)                                             │
# └──────────────────────────────────────────────────────────────────────────────┘

background-opacity = 0.95
background-blur-radius = 20

window-decoration = true
window-padding-color = extend
window-step-resize = false
window-padding-balance = true
window-height = 100
window-width = 100

# Ocultar la barra de pestañas superior (para verla siempre usa: top)
gtk-tabs-location = hidden

# No pedir confirmación al cerrar un panel o ventana
confirm-close-surface = false


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 3. PORTAPAPELES (CLIPBOARD - LINUX / WAYLAND)                                │
# └──────────────────────────────────────────────────────────────────────────────┘

clipboard-read = allow
clipboard-write = allow

# Copiar automáticamente cualquier texto apenas lo selecciones con el mouse:
copy-on-select = clipboard


# ┌──────────────────────────────────────────────────────────────────────────────┐
