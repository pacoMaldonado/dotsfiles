# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 5. ATAJOS DE TECLADO PARA LINUX (KEYBINDINGS)                                │
# └──────────────────────────────────────────────────────────────────────────────┘

# Liberar Alt+Izquierda / Alt+Derecha para navegación natural
keybind = alt+left=unbind
keybind = alt+right=unbind

# --- Copiar y Pegar cómodos con 2 teclas (sin usar 3 teclas Ctrl+Shift+C/V) ---
# Nota: Además de Alt+c, al seleccionar con el mouse se copia solo (copy-on-select = clipboard)
keybind = alt+c=copy_to_clipboard
keybind = alt+v=paste_from_clipboard

# --- Utilidades Rápidas (Accesibles con la mano izquierda usando Alt) ---
keybind = alt+x=clear_screen
keybind = alt+r=reload_config
keybind = alt+w=close_surface
keybind = alt+t=new_tab
keybind = alt+f=toggle_split_zoom

# --- Dividir Pantalla (Splits: 'e' arriba de 'd' en el teclado) ---
keybind = alt+e=new_split:right
keybind = alt+d=new_split:down

# --- Navegar entre Paneles (Estilo Vim: h, j, k, l) ---
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# --- Redimensionar Paneles ---
keybind = ctrl+shift+j=resize_split:up,10
keybind = ctrl+shift+k=resize_split:down,10
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+l=resize_split:right,10

# --- Extras para Neovim y Multilínea ---
# Escribe 'nvim ' en la terminal y presiona [Alt + s] para abrir todo el output en Neovim
keybind = alt+s=write_screen_file:paste
keybind = shift+enter=text:\x1b\r


